# ====================
# СЕРВЕР
# ====================
NODE_ENV=development
PORT=3000
HOST=localhost

# ====================
# БАЗА ДАННЫХ (PostgreSQL)
# ====================
# Локальное подключение
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myapp_db
DB_USER=postgres
DB_PASSWORD=postgres

# Или единая строка подключения
DATABASE_URL=postgresql://postgres:password@localhost:5432/myapp_db

# Пул подключений
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT=30000

# ====================
# JWT (Аутентификация)
# ====================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ====================
# BCRYPT (Хеширование паролей)
# ====================
BCRYPT_SALT_ROUNDS=10

# ====================
# CORS
# ====================
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true

# ====================
# API КЛЮЧИ (если нужны)
# ====================
# API_KEY=your-api-key
# API_SECRET=your-api-secret

# ====================
# ЛОГИРОВАНИЕ
# ====================
LOG_LEVEL=debug
LOG_FORMAT=combined

# ====================
# РЕДИС (если используется)
# ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ====================
# ОТЧЕТЫ (пути сохранения)
# ====================
REPORTS_PATH=./reports
REPORTS_MAX_SIZE=50mb

# ====================
# EMAIL (если нужна отправка)
# ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@myapp.com

# ====================
# РЕЖИМ РАЗРАБОТКИ
# ====================
DEBUG=true
SEED_DATABASE=false

# ====================
# ЛИМИТЫ
# ====================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
FILE_UPLOAD_MAX_SIZE=10mb

# ====================
# ВРЕМЕННЫЕ ЗНАЧЕНИЯ (в миллисекундах)
# ====================
SESSION_TIMEOUT=3600000
CACHE_TTL=60000

# ====================
# БЕЛЫЙ СПИСОК (для админки и т.д.)
# ====================
ADMIN_IPS=127.0.0.1,::1
ALLOWED_DOMAINS=myapp.com,localhost